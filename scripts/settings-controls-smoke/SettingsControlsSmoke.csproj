<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>../../src/Clicky.Windows/app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <ProjectReference Include="../../src/Clicky.Windows/Clicky.Windows.csproj" />
    <EmbeddedResource Include="../../src/Clicky.Windows/App.xaml" LogicalName="SettingsControls.AppStyles.xaml" />
  </ItemGroup>
</Project>
