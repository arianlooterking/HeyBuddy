<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>../../src/Clicky.Windows/app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <Compile Include="../../src/Clicky.Windows/Views/CompanionWindow.cs" Link="CompanionWindow.cs" />
    <Compile Include="../../src/Clicky.Core/AppSettings.cs" Link="AppSettings.cs" />
  </ItemGroup>
</Project>
