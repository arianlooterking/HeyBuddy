<Window x:Class="Clicky.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HeyBuddy" Style="{StaticResource {x:Type Window}}" Width="1120" Height="780" MinWidth="760" MinHeight="570" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDropFiles" Closing="OnClosing">
 <Grid Background="#F8F9FC">
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F0F2F7" BorderBrush="#E1E5EE" BorderThickness="0,0,1,0">
   <Grid Margin="17,25,17,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="11,0,0,25"><Viewbox Width="32" Height="38" Margin="0,0,11,0"><Canvas Width="40" Height="48"><Path Fill="#386BFF" Data="M3,2 L34,29 L22,31 L16,45 Z"/><Ellipse Fill="White" Width="4" Height="5" Canvas.Left="12" Canvas.Top="18"/><Ellipse Fill="White" Width="4" Height="5" Canvas.Left="20" Canvas.Top="20"/></Canvas></Viewbox><TextBlock Text="HeyBuddy" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="NavigationItems">
     <Button Content="Conversation" Tag="chat" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button Content="Apps &amp; actions" Tag="apps" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button Content="Tasks" Tag="tasks" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button Content="History" Tag="history" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button Content="Connections" Tag="connections" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button Content="Memory &amp; skills" Tag="knowledge" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button Content="Models &amp; voices" Tag="models" Style="{StaticResource Nav}" Click="Navigate"/>
     <Button Content="Settings" Tag="settings" Style="{StaticResource Nav}" Click="Navigate"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2"><Border Background="#E4EAFB" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="Your computer. Your controls." FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ProviderLabel" Text="Local AI" FontSize="12" Foreground="#53627E" Margin="0,5,0,0"/><TextBlock x:Name="VersionLabel" FontSize="10" Foreground="#53627E" Margin="0,5,0,0"/></StackPanel></Border><Button Content="Stop everything" Click="StopEverything" Margin="0,13,0,0" Foreground="#A02C37" ToolTip="Ctrl + Alt + Escape"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="New conversation" Click="NewConversation"/><StackPanel><TextBlock x:Name="PageTitle" Text="Conversation" Style="{StaticResource PageHeading}"/><TextBlock x:Name="PageSubtitle" Text="A little help, right where you work." Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="ChatPage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Messages" Margin="0,0,10,12"><Border x:Name="Welcome" Padding="28" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Margin="0,25,0,15"><StackPanel><TextBlock Text="Hey, I’m HeyBuddy." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Ask a question or give me a task. Auto can open apps and use tools; you approve sensitive actions." Foreground="{StaticResource Muted}" FontSize="15" TextWrapping="Wrap" Margin="0,12,0,22" MaxWidth="470" HorizontalAlignment="Left"/><WrapPanel><Button Content="Open an app" Tag="apps" Click="Navigate" Margin="0,0,8,8" Style="{StaticResource Primary}"/><Button Content="Check microphone" Click="ShowMicrophoneSettings" Margin="0,0,8,8"/><Button Content="Models &amp; voices" Click="ShowModels" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="ReadinessText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><TextBlock Text="Tap Ctrl + Alt + Space to start or finish talking · Ctrl + Alt + D for dictation" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
     <Border Grid.Row="1" Background="White" BorderBrush="#CFD7E6" BorderThickness="1" CornerRadius="13" Padding="13"><StackPanel>
      <TextBlock x:Name="AttachmentLabel" Visibility="Collapsed" Foreground="#53627E" FontSize="12" Margin="3,0,0,6"/>
      <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" MinHeight="62" MaxHeight="160" VerticalScrollBarVisibility="Auto" PreviewKeyDown="ComposerKeyDown" AutomationProperties.Name="Message or task"/>
      <DockPanel Margin="0,8,0,0"><Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Click="SendMessage" Style="{StaticResource Primary}" MinWidth="85"/><WrapPanel><ComboBox x:Name="ModeSelector" Width="114" SelectedIndex="0" Margin="0,0,7,0" SelectionChanged="ConversationModeChanged" AutomationProperties.Name="Conversation mode"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Agent"/><ComboBoxItem Content="Dictate"/><ComboBoxItem Content="Chat only"/></ComboBox><Button x:Name="TalkButton" Content="Talk" Click="ToggleTalk" Margin="0,0,7,0"/><Button Content="Attach" Click="AttachFiles" Margin="0,0,9,0"/><CheckBox x:Name="ScreenCheck" Content="Screen" VerticalAlignment="Center" Checked="ScreenChanged" Unchecked="ScreenChanged"/></WrapPanel></DockPanel>
      <TextBlock x:Name="ModeHelp" Text="Auto answers questions and carries out tasks. Sensitive actions ask first." FontSize="11" Foreground="{StaticResource Muted}" Margin="3,8,0,0" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,7,0,0"><Button x:Name="ContinuousButton" Content="Hands-free" Click="ToggleContinuous" Margin="0,0,7,0" ToolTip="Explicitly enable continuous microphone listening. Headphones recommended."/><Button Content="Sketch screen" Click="SketchScreen" Margin="0,0,7,0"/><Button Content="Clear attachments" Click="ClearAttachments"/></WrapPanel>
     </StackPanel></Border>
    </Grid>
    <ScrollViewer x:Name="OtherScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent" Margin="0,0,12,20"/></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Margin="0,12,0,0" Padding="2,5" BorderThickness="0"><StackPanel>
    <StackPanel x:Name="MicrophoneActivity" Visibility="Collapsed" Margin="0,0,0,7"><TextBlock x:Name="MicrophoneActivityLabel" Text="Microphone input" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/><ProgressBar x:Name="MicrophoneInputLevel" Minimum="0" Maximum="100" Height="6" Foreground="#386BFF" AutomationProperties.Name="Microphone input level"/></StackPanel>
    <TextBlock x:Name="StatusText" Text="Ready · Local by default" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="85"/>
   </StackPanel></Border>
  </Grid>
 </Grid>
</Window>
