<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>../../src/Clicky.Windows/app.manifest</ApplicationManifest>
    <!-- WPF owns process DPI initialization; Forms is used for the isolated fixture and audio device UI. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Clicky.Core/Clicky.Core.csproj" />
    <!-- Compile the actual native sources so these checks run independently of connector accounts and UI construction. -->
    <Compile Include="../../src/Clicky.Windows/Native/**/*.cs" Link="Native/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Clicky.Windows/Speech/**/*.cs" Link="Speech/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Clicky.Windows/Views/SketchWindow.cs" Link="Views/SketchWindow.cs" />
    <Compile Include="../../src/Clicky.Windows/Views/GuidanceWindow.cs" Link="Views/GuidanceWindow.cs" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
</Project>
